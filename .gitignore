.venv/
.cache/
__pycache__/
*.py[cod]
.pytest_cache/
wandb/

# Local-only material: operational notes, retired comparison code and the
# working conventions. None of it is needed to reproduce the experiments.
Development/
temporary_checks/
CLAUDE.md

# Generated experimental output. Checkpoints and generated datasets are large,
# so results/ is not tracked; every number a finding relies on is quoted in the
# finding itself. The class split record is the evaluation protocol and must
# stay auditable, so it is the one exception.
results/*
!results/evaluation_data/
results/evaluation_data/*
!results/evaluation_data/class_splits.json
