.venv/
.cache/
__pycache__/
*.py[cod]
.pytest_cache/
wandb/

# Generated runs stay out of version control: checkpoints are ~800 MB per run
# and generated datasets are large. Everything a report or finding depends on is
# quoted in the document itself, and small evidence is copied into findings/.
results/*
!results/evaluation_data/
results/evaluation_data/*
# The class split record IS the evaluation protocol, so it must stay auditable.
!results/evaluation_data/class_splits.json
